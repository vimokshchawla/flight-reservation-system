# Copy to .env (optional - these defaults work as-is)
PORT=5000
# SQLite database file, created automatically with sample data on first start
DB_FILE=data/flight_reservation.db
# Any long random string; used to sign login tokens
AUTH_SECRET=change-this-to-a-long-random-string
# Frontend URL(s) allowed to call the API, comma separated
CORS_ORIGIN=http://localhost:5173
