# Copy this file to .env and fill in your MySQL credentials
PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=flight_reservation_system
# Any long random string; used to sign login tokens
AUTH_SECRET=change-this-to-a-long-random-string
# Frontend URL(s) allowed to call the API, comma separated
CORS_ORIGIN=http://localhost:5173
